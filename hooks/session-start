#!/usr/bin/env bash
# SessionStart hook for engineering-skills plugin.
# Injects the shared engineering principles + a skill-pack bootstrap as
# additionalContext, so every session starts with the discipline loaded
# and the awareness that 33 lifecycle skills are available.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PLUGIN_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Read the shared engineering principles.
principles_content=$(cat "${PLUGIN_ROOT}/references/engineering-principles.md" 2>&1 || echo "Error reading engineering-principles.md")

# Escape string for JSON embedding using bash parameter substitution.
escape_for_json() {
    local s="$1"
    s="${s//\\/\\\\}"
    s="${s//\"/\\\"}"
    s="${s//$'\n'/\\n}"
    s="${s//$'\r'/\\r}"
    s="${s//$'\t'/\\t}"
    printf '%s' "$s"
}

principles_escaped=$(escape_for_json "$principles_content")

session_context="<EXTREMELY_IMPORTANT>\nYou have the engineering-skills pack — 33 skills organized by the software development lifecycle (product, research, design, develop, tune, test, verify, ship, operate) plus a meta router.\n\nTo route a task to the right skill, invoke the \`using-skills\` skill via the Skill tool, or invoke any skill directly by name (e.g. tdd, code-review, debugging, brainstorm, spec).\n\nPlanning uses your built-in plan mode (EnterPlanMode/ExitPlanMode), not a custom skill.\n\nBelow are the shared engineering principles every skill in this pack assumes. Apply them at all times:\n\n${principles_escaped}\n</EXTREMELY_IMPORTANT>"

# Emit context injection as JSON.
# Cursor hooks expect additional_context (snake_case).
# Claude Code hooks expect hookSpecificOutput.additionalContext (nested).
# Copilot CLI (v1.0.11+) and others expect additionalContext (top-level, SDK standard).
if [ -n "${CURSOR_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context" | cat
elif [ -n "${CLAUDE_PLUGIN_ROOT:-}" ] && [ -z "${COPILOT_CLI:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context" | cat
else
  printf '{\n  "additionalContext": "%s"\n}\n' "$session_context" | cat
fi

exit 0
